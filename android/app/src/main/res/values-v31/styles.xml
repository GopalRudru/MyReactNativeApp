<resources>

    <!-- Android 12+ system splash: white background so the handoff to
         SplashTheme's windowBackground and the launch_screen dialog is seamless. -->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
